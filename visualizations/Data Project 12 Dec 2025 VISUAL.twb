        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial'>Households with High Income Loss + Vulnerability</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MASTER_dataset CLEANED' name='federated.11ca6al0pgqyer12ckcpb0u8oicr' />
          </datasources>
          <datasource-dependencies datasource='federated.11ca6al0pgqyer12ckcpb0u8oicr'>
            <column caption='Household Income' datatype='real' name='[Calculation_0009315149418497]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([acs_median_hh_income]) OR [acs_median_hh_income] &lt;= 0&#10;THEN 0&#10;ELSE [acs_median_hh_income]&#10;END' />
            </column>
            <column caption='Income Loss % (Tract-Level)' datatype='real' name='[Calculation_4045057000574979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_0009315149418497]) OR ISNULL([nri_top3_eal_per_household_usd]) THEN 0&#10;ELSE [nri_top3_eal_per_household_usd] / [Calculation_0009315149418497]&#10;END' />
            </column>
            <column caption='City UPDATE' datatype='string' name='[Calculation_4442267196592128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [city_name] = &quot;Unincorporated Area&quot; THEN&#10;    IF [county_name] = &quot;Miami-Dade&quot; THEN &quot;Unincorporated Miami-Dade&quot;&#10;    ELSEIF [county_name] = &quot;Broward&quot; THEN &quot;Unincorporated Broward&quot;&#10;    ELSEIF [county_name] = &quot;Palm Beach&quot; THEN &quot;Unincorporated Palm Beach&quot;&#10;    ELSEIF [county_name] = &quot;Monroe&quot; THEN &quot;Unincorporated Monroe&quot;&#10;    ELSE &quot;Unincorporated (Other)&quot;&#10;    END&#10;ELSE&#10;    [city_name]&#10;END' />
            </column>
            <column caption='Households at Intersection' datatype='real' name='[Financial / Equity Risk (copy)_2507409419390976]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;)&#10;AND [svi_overall_score] &gt;= 8&#10;AND [Calculation_4045057000574979] &gt;= 0.03&#10;THEN [acs_households]&#10;END' />
            </column>
            <column caption='Households' datatype='real' name='[acs_households]' role='measure' type='quantitative' />
            <column datatype='real' name='[acs_median_hh_income]' role='measure' type='ordinal' />
            <column caption='Population' datatype='real' name='[acs_population]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='County Name' datatype='string' name='[county_name]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Flood Hurricane Dominance' datatype='string' name='[flood_hurricane_dominance]' role='dimension' type='nominal' />
            <column caption='Geoid' datatype='string' name='[geoid]' role='dimension' type='nominal' />
            <column-instance column='[acs_households]' derivation='None' name='[none:acs_households:ok]' pivot='key' type='ordinal' />
            <column-instance column='[acs_population]' derivation='None' name='[none:acs_population:ok]' pivot='key' type='ordinal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[county_name]' derivation='None' name='[none:county_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[geoid]' derivation='None' name='[none:geoid:nk]' pivot='key' type='nominal' />
            <column-instance column='[tract_land_type]' derivation='None' name='[none:tract_land_type:nk]' pivot='key' type='nominal' />
            <column caption='Annual Loss per Household' datatype='real' name='[nri_top3_eal_per_household_usd]' role='measure' type='ordinal' />
            <column-instance column='[Financial / Equity Risk (copy)_2507409419390976]' derivation='Sum' name='[sum:Financial / Equity Risk (copy)_2507409419390976:qk]' pivot='key' type='quantitative' />
            <column caption='Svi Overall Score' datatype='real' name='[svi_overall_score]' role='measure' type='ordinal' />
            <column datatype='string' name='[tract_land_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[Action (City Name,County Name)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_A3BE5E5C8C4E4600B9999F03E50E02D1]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[city_name]' />
              <groupfilter function='level-members' level='[county_name]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[Action (City UPDATE)]'>
            <groupfilter function='level-members' level='[Calculation_4442267196592128]' user:ui-action-filter='[Action1_A3BE5E5C8C4E4600B9999F03E50E02D1]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:city_name:nk]' context='true' filter-group='4'>
            <groupfilter function='level-members' level='[none:city_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:county_name:nk]' context='true' filter-group='9'>
            <groupfilter function='level-members' level='[none:county_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:geoid:nk]' context='true' filter-group='7'>
            <groupfilter function='level-members' level='[none:geoid:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:city_name:nk]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:county_name:nk]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:geoid:nk]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:tract_land_type:nk]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[Action (City Name,County Name)]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[Action (City UPDATE)]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:acs_population:ok]</column>
            <column>[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:acs_households:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[sum:Financial / Equity Risk (copy)_2507409419390976:qk]' value='n#,##0,K;-#,##0,K' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.11ca6al0pgqyer12ckcpb0u8oicr].[sum:Financial / Equity Risk (copy)_2507409419390976:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#000000' fontname='Arial'>Definition: ≥3% of income lost annually (expected)</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold='true' fontname='Arial' fontsize='20'><![CDATA[<[federated.11ca6al0pgqyer12ckcpb0u8oicr].[sum:Financial / Equity Risk (copy)_2507409419390976:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontname='Arial' fontsize='10'>Households with High </run>
                <run>Æ&#10;</run>
                <run fontname='Arial' fontsize='10'>Income Loss + Vulnerability</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='cell'>
                <format attr='text-align' value='center' />
              </style-rule>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
        <tooltip-style tooltip-mode='none' />
      </table>
      <simple-id uuid='{8D6C8602-F8E6-4B5E-850A-2BF0535DCCD9}' />
