    <worksheet name='Map - Financial Strain Hotspots'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial'>Financial Strain Hotspots</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='10'><![CDATA[<[federated.11ca6al0pgqyer12ckcpb0u8oicr].[none:Calculation_2507409627619330:nk]> ]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='10'>of high income-loss tracts are also highly socially vulnerable</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MASTER_dataset CLEANED' name='federated.11ca6al0pgqyer12ckcpb0u8oicr' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.11ca6al0pgqyer12ckcpb0u8oicr'>
            <column caption='Household Income' datatype='real' name='[Calculation_0009315149418497]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([acs_median_hh_income]) OR [acs_median_hh_income] &lt;= 0&#10;THEN 0&#10;ELSE [acs_median_hh_income]&#10;END' />
            </column>
            <column caption='% High Loss Also High SVI' datatype='string' name='[Calculation_2507409627619330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND(&#10;{ FIXED : SUM([Households at Intersection (copy)_2507409629605892]) }&#10;/&#10;{ FIXED : SUM([Households with ≥3% Income Loss (copy)_2507409629245443]) }&#10;* 100&#10;,0))&#10;+ &quot;%&quot;' />
            </column>
            <column caption='Income Loss % (Tract-Level)' datatype='real' name='[Calculation_4045057000574979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_0009315149418497]) OR ISNULL([nri_top3_eal_per_household_usd]) THEN 0&#10;ELSE [nri_top3_eal_per_household_usd] / [Calculation_0009315149418497]&#10;END' />
            </column>
            <column caption='Income Loss Category' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4045061221797915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Categorize burden severity for color coding&#10;&#10;IF [Calculation_4045057000574979] &gt;= 0.03 THEN &quot;High (≥3%)&quot;&#10;ELSEIF [Calculation_4045057000574979] &gt;= 0.01 and [Calculation_4045057000574979] &lt; 0.03 THEN &quot;Moderate (1-3%)&quot;&#10;ELSE &quot;Low (&lt;1%)&quot;&#10;END' />
            </column>
            <column caption='City UPDATE' datatype='string' name='[Calculation_4442267196592128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [city_name] = &quot;Unincorporated Area&quot; THEN&#10;    IF [county_name] = &quot;Miami-Dade&quot; THEN &quot;Unincorporated Miami-Dade&quot;&#10;    ELSEIF [county_name] = &quot;Broward&quot; THEN &quot;Unincorporated Broward&quot;&#10;    ELSEIF [county_name] = &quot;Palm Beach&quot; THEN &quot;Unincorporated Palm Beach&quot;&#10;    ELSEIF [county_name] = &quot;Monroe&quot; THEN &quot;Unincorporated Monroe&quot;&#10;    ELSE &quot;Unincorporated (Other)&quot;&#10;    END&#10;ELSE&#10;    [city_name]&#10;END' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='Households at Intersection FLAG' datatype='integer' name='[Households at Intersection (copy)_2507409629605892]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;)&#10;AND [svi_overall_score] &gt;= 8&#10;AND [Calculation_4045057000574979] &gt;= 0.03&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Households with ≥3% Income Loss FLAG' datatype='integer' name='[Households with ≥3% Income Loss (copy)_2507409629245443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;) and&#10;[Calculation_4045057000574979] &gt;= 0.03&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Svi Overall Score (copy)' datatype='real' name='[Svi Overall Score (copy)_4045059122929682]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[svi_overall_score]' />
            </column>
            <column datatype='real' name='[acs_avg_hh_size]' role='measure' type='ordinal' />
            <column caption='Households' datatype='real' name='[acs_households]' role='measure' type='quantitative' />
            <column datatype='real' name='[acs_median_hh_income]' role='measure' type='ordinal' />
            <column caption='Population' datatype='real' name='[acs_population]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Geometry]' derivation='Collect' name='[clct:Geometry:nk]' pivot='key' type='nominal' />
            <column caption='County Name' datatype='string' name='[county_name]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Flood Hurricane Dominance' datatype='string' name='[flood_hurricane_dominance]' role='dimension' type='nominal' />
            <column caption='Geoid' datatype='string' name='[geoid]' role='dimension' type='nominal' />
            <column caption='Nfhl In Floodplain' datatype='integer' name='[nfhl_in_floodplain]' role='measure' type='ordinal' />
            <column-instance column='[Calculation_0009315149418497]' derivation='None' name='[none:Calculation_0009315149418497:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2507409627619330]' derivation='None' name='[none:Calculation_2507409627619330:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4045057000574979]' derivation='None' name='[none:Calculation_4045057000574979:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4045061221797915]' derivation='None' name='[none:Calculation_4045061221797915:nk]' pivot='key' type='nominal' />
            <column-instance column='[Svi Overall Score (copy)_4045059122929682]' derivation='None' name='[none:Svi Overall Score (copy)_4045059122929682:ok]' pivot='key' type='ordinal' />
            <column-instance column='[acs_avg_hh_size]' derivation='None' name='[none:acs_avg_hh_size:ok]' pivot='key' type='ordinal' />
            <column-instance column='[acs_households]' derivation='None' name='[none:acs_households:ok]' pivot='key' type='ordinal' />
            <column-instance column='[acs_households]' derivation='None' name='[none:acs_households:qk]' pivot='key' type='quantitative' />
            <column-instance column='[acs_population]' derivation='None' name='[none:acs_population:ok]' pivot='key' type='ordinal' />
            <column-instance column='[acs_population]' derivation='None' name='[none:acs_population:qk]' pivot='key' type='quantitative' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
