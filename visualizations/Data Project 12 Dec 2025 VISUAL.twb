            <column-instance column='[tract_land_type]' derivation='None' name='[none:tract_land_type:nk]' pivot='key' type='nominal' />
            <column caption='Annual Loss per Household' datatype='real' name='[nri_top3_eal_per_household_usd]' role='measure' type='quantitative' />
