      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial'>Insight - Top Cities by Income Loss %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MASTER_dataset CLEANED' name='federated.11ca6al0pgqyer12ckcpb0u8oicr' />
          </datasources>
          <datasource-dependencies datasource='federated.11ca6al0pgqyer12ckcpb0u8oicr'>
            <column caption='Household Income' datatype='real' name='[Calculation_0009315149418497]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([acs_median_hh_income]) OR [acs_median_hh_income] &lt;= 0&#10;THEN 0&#10;ELSE [acs_median_hh_income]&#10;END' />
            </column>
            <column caption='Income Loss % (City-Level)' datatype='real' name='[Calculation_2834308313493514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2834308953518119]&#10;/&#10;[Calculation_2834308953804840]' />
            </column>
            <column caption='Annual Loss per Household (City-Level)' datatype='real' name='[Calculation_2834308953518119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nri_top3_hazards_eal_total_usd])&#10;/&#10;SUM([acs_households])' />
            </column>
            <column caption='Household Income (City-Level)' datatype='real' name='[Calculation_2834308953804840]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM([acs_median_hh_income] * [acs_households])&#10;/&#10;SUM([acs_households])' />
            </column>
            <column caption='Income Loss % (Tract-Level)' datatype='real' name='[Calculation_4045057000574979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_0009315149418497]) OR ISNULL([nri_top3_eal_per_household_usd]) THEN 0&#10;ELSE [nri_top3_eal_per_household_usd] / [Calculation_0009315149418497]&#10;END' />
            </column>
            <column caption='Income Bins' datatype='string' name='[Calculation_4045061218635799]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0009315149418497] &lt; 50000 &#10;THEN &quot;&lt;$50K&quot;&#10;ELSEIF [Calculation_0009315149418497] &gt;= 50000 and [Calculation_0009315149418497] &lt; 75000&#10;THEN &quot;$50K-$75K&quot;&#10;ELSEIF [Calculation_0009315149418497] &gt;= 75000 and [Calculation_0009315149418497] &lt; 100000&#10;THEN &quot;$75K-$100K&quot;&#10;ELSE &quot;&gt;$100K&quot;&#10;END' />
            </column>
            <column caption='Income Loss Category' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4045061221797915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Categorize burden severity for color coding&#10;&#10;IF [Calculation_4045057000574979] &gt;= 0.03 THEN &quot;High (≥3%)&quot;&#10;ELSEIF [Calculation_4045057000574979] &gt;= 0.01 and [Calculation_4045057000574979] &lt; 0.03 THEN &quot;Moderate (1-3%)&quot;&#10;ELSE &quot;Low (&lt;1%)&quot;&#10;END' />
            </column>
            <column caption='City UPDATE' datatype='string' name='[Calculation_4442267196592128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [city_name] = &quot;Unincorporated Area&quot; THEN&#10;    IF [county_name] = &quot;Miami-Dade&quot; THEN &quot;Unincorporated Miami-Dade&quot;&#10;    ELSEIF [county_name] = &quot;Broward&quot; THEN &quot;Unincorporated Broward&quot;&#10;    ELSEIF [county_name] = &quot;Palm Beach&quot; THEN &quot;Unincorporated Palm Beach&quot;&#10;    ELSEIF [county_name] = &quot;Monroe&quot; THEN &quot;Unincorporated Monroe&quot;&#10;    ELSE &quot;Unincorporated (Other)&quot;&#10;    END&#10;ELSE&#10;    [city_name]&#10;END' />
            </column>
            <column caption='Svi Overall Score (copy)' datatype='real' name='[Svi Overall Score (copy)_4045059122929682]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[svi_overall_score]' />
            </column>
