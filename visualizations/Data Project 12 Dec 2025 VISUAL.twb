    <worksheet name='KPI Total Uninsured Loss'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial'>Total Uninsured Loss</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MASTER_dataset CLEANED' name='federated.11ca6al0pgqyer12ckcpb0u8oicr' />
          </datasources>
          <datasource-dependencies datasource='federated.11ca6al0pgqyer12ckcpb0u8oicr'>
            <column caption='Household Income' datatype='real' name='[Calculation_0009315149418497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([acs_median_hh_income]) THEN 0&#10;else [acs_median_hh_income]&#10;end' />
            </column>
            <column caption='Income Loss %' datatype='real' name='[Calculation_4045057000574979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[nri_top3_eal_per_household_usd] / [Calculation_0009315149418497]' />
            </column>
            <column caption='Uninsured Loss' datatype='real' name='[Calculation_4045061221244952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Total annual climate losses faced by uninsured populations&#10;&#10;IF ISNULL([svi_uninsured_pct]) OR ISNULL([nri_top3_hazards_eal_total_usd]) &#10;THEN 0&#10;ELSE &#10;    [nri_top3_hazards_eal_total_usd] * ([svi_uninsured_pct] / 100)&#10;END' />
            </column>
            <column caption='Income Loss Category' datatype='string' name='[Calculation_4045061221797915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Categorize burden severity for color coding&#10;&#10;IF [Calculation_4045057000574979] &gt;= 0.03 THEN &quot;High (≥3%)&quot;&#10;ELSEIF [Calculation_4045057000574979] &gt;= 0.01 and [Calculation_4045057000574979] &lt; 0.03 THEN &quot;Moderate (1-3%)&quot;&#10;ELSE &quot;Low (&lt;1%)&quot;&#10;END' />
            </column>
            <column caption='City UPDATE' datatype='string' name='[Calculation_4442267196592128]' role='dimension' type='nominal'>
