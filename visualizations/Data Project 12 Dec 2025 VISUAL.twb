          <datasource-dependencies datasource='federated.11ca6al0pgqyer12ckcpb0u8oicr'>
            <column caption='City Total EAL' datatype='real' name='[Calculation_2834308912369675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_4442267196592128] :&#10;    SUM([nri_top3_hazards_eal_total_usd])&#10;}' />
            </column>
            <column caption='Total EAL Held by Top N' datatype='real' name='[Calculation_2834308916551696]' role='measure' type='quantitative'>
