            <column-instance column='[svi_overall_score]' derivation='None' name='[none:svi_overall_score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[tract_land_type]' derivation='None' name='[none:tract_land_type:nk]' pivot='key' type='nominal' />
