      <aliases enabled='yes' />
      <column caption='Household Income' datatype='real' name='[Calculation_0009315149418497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([acs_median_hh_income]) THEN 0&#10;else [acs_median_hh_income]&#10;end' />
      </column>
      <column caption='% High Loss Also High SVI' datatype='string' name='[Calculation_2507409627619330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(&#10;{ FIXED : SUM([Households at Intersection (copy)_2507409629605892]) }&#10;/&#10;{ FIXED : SUM([Households with ≥3% Income Loss (copy)_2507409629245443]) }&#10;* 100&#10;,0))&#10;+ &quot;%&quot;' />
      </column>
      <column caption='Income Loss %' datatype='real' name='[Calculation_4045057000574979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nri_top3_eal_per_household_usd] / [Calculation_0009315149418497]' />
      </column>
      <column caption='Households in Flood &amp; Hurricane Dominant Areas' datatype='real' name='[Calculation_4045057016705029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;) THEN [acs_households] END' />
      </column>
      <column caption='Percent of Areas with FEMA Flood Risk' datatype='real' name='[Calculation_4045057336975366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nfhl_in_floodplain]) / COUNT([geoid])' />
      </column>
      <column caption='Total Annual Climate Loss in Floodplain' datatype='real' name='[Calculation_4045057343639559]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [nfhl_in_floodplain] = 1 &#10;THEN [nri_top3_hazards_eal_total_usd] END' />
      </column>
      <column caption='Climate Loss as % of Annual Rent' datatype='real' name='[Calculation_4045057345572873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nri_top3_eal_per_household_usd] / ([acs_median_hh_income] * 0.30)' />
      </column>
      <column caption='Social Vulnerability in High-Exposure Areas' datatype='real' name='[Calculation_4045057347252234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;) &#10;THEN [svi_overall_score] END' />
      </column>
      <column caption='Households Facing High Social Vulnerability' datatype='real' name='[Calculation_4045057348911115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;) and&#10;[svi_overall_pctile] &gt;= 0.80&#10;THEN [acs_households]&#10;END' />
      </column>
      <column caption='Households with ≥3% Income Loss' datatype='real' name='[Calculation_4045057350017036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;) and&#10;[Calculation_4045057000574979] &gt;= 0.03&#10;THEN [acs_households]&#10;END' />
      </column>
      <column caption='Households in FEMA Floodplains' datatype='real' name='[Calculation_4045061110603798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [nfhl_in_floodplain] = 1 then [acs_households] END' />
      </column>
      <column caption='Income Bins' datatype='string' name='[Calculation_4045061218635799]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0009315149418497] &lt; 50000 &#10;THEN &quot;&lt;$50K&quot;&#10;ELSEIF [Calculation_0009315149418497] &gt;= 50000 and [Calculation_0009315149418497] &lt; 75000&#10;THEN &quot;$50K-$75K&quot;&#10;ELSEIF [Calculation_0009315149418497] &gt;= 75000 and [Calculation_0009315149418497] &lt; 100000&#10;THEN &quot;$75K-$100K&quot;&#10;ELSE &quot;&gt;$100K&quot;&#10;END' />
      </column>
      <column caption='Uninsured Loss' datatype='real' name='[Calculation_4045061221244952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total annual climate losses faced by uninsured populations&#10;&#10;IF ISNULL([svi_uninsured_pct]) OR ISNULL([nri_top3_hazards_eal_total_usd]) &#10;THEN 0&#10;ELSE &#10;    [nri_top3_hazards_eal_total_usd] * ([svi_uninsured_pct] / 100)&#10;END' />
      </column>
      <column caption='Uninsured Loss Per  Household' datatype='real' name='[Calculation_4045061221548058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// How much loss each uninsured household faces&#10;&#10;IF ISNULL([svi_uninsured_pct]) OR ISNULL([nri_top3_eal_per_household_usd_capped]) &#10;THEN 0&#10;ELSE &#10;    [nri_top3_eal_per_household_usd_capped] * ([svi_uninsured_pct] / 100)&#10;END' />
      </column>
      <column caption='Income Loss Category' datatype='string' name='[Calculation_4045061221797915]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Categorize burden severity for color coding&#10;&#10;IF [Calculation_4045057000574979] &gt;= 0.03 THEN &quot;High (≥3%)&quot;&#10;ELSEIF [Calculation_4045057000574979] &gt;= 0.01 and [Calculation_4045057000574979] &lt; 0.03 THEN &quot;Moderate (1-3%)&quot;&#10;ELSE &quot;Low (&lt;1%)&quot;&#10;END' />
      </column>
      <column caption='Uninsured Loss %' datatype='real' name='[Calculation_4045061245620252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[svi_uninsured_pct]/100' />
      </column>
      <column caption='City UPDATE' datatype='string' name='[Calculation_4442267196592128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [city_name] = &quot;Unincorporated Area&quot; THEN&#10;    IF [county_name] = &quot;Miami-Dade&quot; THEN &quot;Unincorporated Miami-Dade&quot;&#10;    ELSEIF [county_name] = &quot;Broward&quot; THEN &quot;Unincorporated Broward&quot;&#10;    ELSEIF [county_name] = &quot;Palm Beach&quot; THEN &quot;Unincorporated Palm Beach&quot;&#10;    ELSEIF [county_name] = &quot;Monroe&quot; THEN &quot;Unincorporated Monroe&quot;&#10;    ELSE &quot;Unincorporated (Other)&quot;&#10;    END&#10;ELSE&#10;    [city_name]&#10;END' />
      </column>
      <column caption='Financial / Equity Risk' datatype='string' name='[Calculation_4442267474116609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([svi_overall_score])&#10;AND NOT ISNULL([Calculation_4045057000574979])&#10;AND [svi_overall_score] &gt;= 8&#10;AND [Calculation_4045057000574979] &gt;= 0.03&#10;AND [flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;)&#10;THEN &quot;✔&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Households at Intersection' datatype='real' name='[Financial / Equity Risk (copy)_2507409419390976]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;)&#10;AND [svi_overall_score] &gt;= 8&#10;AND [Calculation_4045057000574979] &gt;= 0.03&#10;THEN [acs_households]&#10;END' />
      </column>
      <column caption='Households at Intersection FLAG' datatype='integer' name='[Households at Intersection (copy)_2507409629605892]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;)&#10;AND [svi_overall_score] &gt;= 8&#10;AND [Calculation_4045057000574979] &gt;= 0.03&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Households with ≥3% Income Loss FLAG' datatype='integer' name='[Households with ≥3% Income Loss (copy)_2507409629245443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[flood_hurricane_dominance] IN (&quot;High&quot;, &quot;Very High&quot;) and&#10;[Calculation_4045057000574979] &gt;= 0.03&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
